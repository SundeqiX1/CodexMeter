{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexMeter",
  "version": "0.1.0",
  "identifier": "app.codexmeter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Codex Usage",
        "width": 340,
        "height": 488,
        "minWidth": 340,
        "minHeight": 488,
        "maxWidth": 340,
        "maxHeight": 488,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "center": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "widget",
        "title": "CodexMeter Widget",
        "width": 224,
        "height": 48,
        "minWidth": 164,
        "minHeight": 48,
        "maxWidth": 224,
        "maxHeight": 118,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Private, glanceable Codex quota monitoring",
    "longDescription": "A lightweight cross-platform menu bar, tray, and floating widget for local Codex quota data.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
