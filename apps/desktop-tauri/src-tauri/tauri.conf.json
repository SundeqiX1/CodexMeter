{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Tool",
  "version": "0.2.0",
  "identifier": "io.github.changzhengithub.codexquotatool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Quota Tool",
        "width": 410,
        "height": 650,
        "minWidth": 410,
        "minHeight": 650,
        "maxWidth": 410,
        "maxHeight": 650,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Codex quota in a compact desktop widget",
    "longDescription": "A cross-platform desktop widget that displays quota from your local Codex session.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "allowDowngrades": false
    }
  }
}

